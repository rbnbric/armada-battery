zn "BATTERY"
write "EDGE_CORPUS_BEGIN",!
set sc=##class(Battery.Interop.Demo).Start()
set sc=##class(Ens.Director).CreateBusinessService("Battery.Intake",.service)
if $SYSTEM.Status.IsError(sc) { write "SERVICE_ERROR=",$SYSTEM.Status.GetErrorText(sc),! halt }
set request=##class(Battery.Interop.CaseRequest).%New()
set request.CaseJSON="{""id"":""edge-alias_match"",""rule"":""For partner A schema v2, copy legacy clientId to customerId and accept when target validation confirms the value."",""expected"":""target accepted customerId=C17"",""acceptance"":""Target accepts the value required by the active partner contract."",""observed"":""target accepted customerId=C17"",""facts"":{""A1"":""Partner A contract is v2 and maps clientId to customerId."",""A2"":""Saved target validation accepted customerId=C17.""}}"
set sc=service.ProcessInput(request,.response)
if $SYSTEM.Status.IsError(sc) { write "CASE_ERROR=",$SYSTEM.Status.GetErrorText(sc),! } else { set row={"id":(response.CaseId),"state":(response.State),"verdict":(response.ReviewerVerdict),"output":(response.OutputResult),"applicability":(response.ReviewerApplicability),"probe":(response.InvestigatorProbe),"explanation":(response.Explanation),"reviewer_usage":(response.ReviewerUsageJSON),"investigator_usage":(response.InvestigatorUsageJSON)} write "EDGE_CASE=",row.%ToJSON(),! }
set request=##class(Battery.Interop.CaseRequest).%New()
set request.CaseJSON="{""id"":""edge-accurate_rule_bad_output"",""rule"":""For partner A schema v2, a valid customerId is accepted by target validation."",""expected"":""target accepted customerId=C17"",""acceptance"":""The request creates at most one external effect for the same scoped key."",""observed"":""target accepted customerId=C17; two outbound effects recorded"",""facts"":{""A3"":""Partner A schema v2 requires customerId, and target validation accepted C17."",""A4"":""Effect ledger records two outbound effects for Partner A/key K17.""}}"
