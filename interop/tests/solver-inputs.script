zn "BATTERY"
set rs=##class(%SQL.Statement).%ExecDirect(,"SELECT ID,""Role"",CaseJSON FROM Battery_Interop.AgentRequest WHERE ID IN (SELECT MessageBodyId FROM Ens.MessageHeader WHERE MessageBodyClassName='Battery.Interop.AgentRequest' AND SessionId IN (SELECT h.SessionId FROM Ens.MessageHeader h JOIN Battery_Interop.CaseResponse r ON h.MessageBodyId=r.ID WHERE h.MessageBodyClassName='Battery.Interop.CaseResponse' AND r.CaseId LIKE 'solver4-live-%')) ORDER BY ID")
if rs.%SQLCODE<0 { write "EXPORT_ERROR=",rs.%Message,! halt }
while rs.%Next() { set row={"ID":(rs.%Get("ID")),"Role":(rs.%Get("Role")),"CaseJSON":(rs.%Get("CaseJSON"))} write "INPUTS=",row.%ToJSON(),! }
write "EXPORT_END",!
halt
