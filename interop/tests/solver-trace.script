zn "BATTERY"
set rs=##class(%SQL.Statement).%ExecDirect(,"SELECT ID,SessionId,SourceConfigName,TargetConfigName,MessageBodyClassName,MessageBodyId,Status FROM Ens.MessageHeader WHERE SessionId IN (SELECT h.SessionId FROM Ens.MessageHeader h JOIN Battery_Interop.CaseResponse r ON h.MessageBodyId=r.ID WHERE h.MessageBodyClassName='Battery.Interop.CaseResponse' AND r.CaseId LIKE 'solver4-live-%') ORDER BY ID")
if rs.%SQLCODE<0 { write "EXPORT_ERROR=",rs.%Message,! halt }
while rs.%Next() { set row={"ID":(rs.%Get("ID")),"SessionId":(rs.%Get("SessionId")),"SourceConfigName":(rs.%Get("SourceConfigName")),"TargetConfigName":(rs.%Get("TargetConfigName")),"MessageBodyClassName":(rs.%Get("MessageBodyClassName")),"MessageBodyId":(rs.%Get("MessageBodyId")),"Status":(rs.%Get("Status"))} write "TRACE=",row.%ToJSON(),! }
write "EXPORT_END",!
halt
