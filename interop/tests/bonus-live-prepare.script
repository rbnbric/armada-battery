zn "BATTERY"
write "TRACE_RUNTIME=",$ZVERSION,!
set sc=##class(Ens.Director).StopProduction()
if $SYSTEM.Status.IsError(sc) { write "TRACE_ERROR=",$SYSTEM.Status.GetErrorText(sc),! halt }
set sc=$SYSTEM.OBJ.LoadDir("/home/irisowner/dev/interop/Battery","ck",,1)
if $SYSTEM.Status.IsError(sc) { write "TRACE_ERROR=",$SYSTEM.Status.GetErrorText(sc),! halt }
set sc=##class(Ens.Director).StartProduction("Battery.Interop.Production")
if $SYSTEM.Status.IsError(sc) { write "TRACE_ERROR=",$SYSTEM.Status.GetErrorText(sc),! halt }
write "TRACE_PREPARE_OK",!
halt
