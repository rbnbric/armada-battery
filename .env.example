# The default synthetic demonstration needs no .env file. Copy this file only
# when starting the full IRIS-backed stack.
#
# Copy to .env and replace this value before starting the IRIS stack.
# Use 8–32 characters: the initial Web Gateway credential setup has this limit.
# IRIS_PASSWORD becomes the IRIS _SYSTEM password: iris-init writes it to the
# durable volume on each `docker compose up`, and IRIS applies it at startup.
# Battery uses the same value for its API login.
IRIS_PASSWORD=change-this-demo-pass-2026
# Host ports published on 127.0.0.1.
IRIS_PORT=52773
IRIS_SUPERSERVER_PORT=1972
BATTERY_PORT=8080
# Pin 2026.1 while the 2026.2 image lacks CSPpwd for --password-file.
IRIS_IMAGE=containers.intersystems.com/intersystems/iris-community:2026.1
